# Environment Configuration for Video RAG Phase 1
# Obtain your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Default LLM Model to use (e.g. gemini-1.5-flash, gemini-2.0-flash, or gemini-1.5-pro)
GEMINI_MODEL=gemini-1.5-flash

# Optional: Embedding model name on Hugging Face
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
